# Copia este archivo a .env.local y llena los valores de tu proyecto de Supabase
# (Supabase → Project Settings → API).
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Publishable key (sb_publishable_...) o anon key. Es pública por diseño: la seguridad la dan las políticas RLS.
VITE_SUPABASE_KEY=sb_publishable_xxx
